Output out/activate-signers-file.gif

Set Shell "bash"
Set Width 1200
Set Height 750
Set TypingSpeed $TYPING_SPEED
Set PlaybackSpeed 1.0

Type 'asfaload-cli sign-pending --secret-key ~/.asfaload/key_1 --digest "$ASFALOAD_DEMO_PENDING_SIGNERS_DIGEST" "$ASFALOAD_DEMO_PENDING_SIGNERS_PATH"'
Enter
$SLEEP 3s

Type 'asfaload-cli sign-pending --secret-key ~/.asfaload/key_2 --digest "$ASFALOAD_DEMO_PENDING_SIGNERS_DIGEST" "$ASFALOAD_DEMO_PENDING_SIGNERS_PATH"'
Enter
Sleep $END_PAUSE
