#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"

. "$REPO_ROOT/tests/e2e_tests/lib/helpers.sh"
. "$SCRIPT_DIR/../lib.sh"

# --- Defaults ---
PENDING_COUNT=5

# --- Usage ---
usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Set up a local asfaload test environment for manual CLI testing.

Starts a local rest-api backend and file server, creates and activates a
signers file (key_0, key_1, key_2; threshold 2), registers PENDING_COUNT
pending release files, then drops you into an interactive shell with all
connection details pre-set as environment variables.

Type 'exit' in the shell to stop all servers and clean up.

OPTIONS
  --pending-count N   Number of pending release files to register (default: $PENDING_COUNT)
  -h, --help          Show this help message and exit

ENVIRONMENT SET IN SPAWNED SHELL
  ASFALOAD_BACKEND_URL   Backend REST API address
  ASFALOAD_PASSWORD_FILE Path to file containing the key password
  KEY_0 KEY_1 KEY_2      Paths to fixture private keys
  FILE_SERVER_URL        Local file server address
  PATH                   target/debug prepended (asfaload-cli available directly)

EXAMPLES
  # Default: spin up with 5 pending files
  $(basename "$0")

  # Spin up with 3 pending files (faster)
  $(basename "$0") --pending-count 3

  # Inside the spawned shell:
  asfaload-cli list-pending -K \$KEY_0
  asfaload-cli sign-pending -K \$KEY_0
EOF
}

# --- Argument parsing ---
while [[ $# -gt 0 ]]; do
    case "$1" in
        --pending-count)
            PENDING_COUNT="${2:?--pending-count requires a value}"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            printf '%sUnknown argument: %s%s\n' "$RED" "$1" "$RESET" >&2
            usage >&2
            exit 1
            ;;
    esac
done

# --- Temp workspace ---

mt_init_workspace

# --- Build ---

mt_build_binaries

# --- File server ---

mt_start_file_server

# --- Backend ---

mt_start_backend

# --- Signers file activation ---
printf '%sActivating signers file...%s ' "$DIM" "$RESET"

mkdir -p "$PROJECT_DIR/$HIDDEN_SIGNERS_DIR"

SIGNERS_FILE_NAME="signers_file_1${_SIGNERS_SUFFIX}.json"
SIGNERS_FILE_PATH="$PROJECT_DIR/$HIDDEN_SIGNERS_DIR/$SIGNERS_FILE_NAME"
SIGNERS_FILE_URL="$FILE_SERVER_URL/project/$HIDDEN_SIGNERS_DIR/$SIGNERS_FILE_NAME"

"$CLI" new-signers-file \
    --artifact-signers-file "${KEY_0}.pub" \
    --artifact-signers-file "${KEY_1}.pub" \
    --artifact-signers-file "${KEY_2}.pub" \
    -A 2 \
    -o "$SIGNERS_FILE_PATH" \
    > /dev/null 2>&1

"$CLI" register-repo \
    --secret-key "$KEY_0" \
    -u "$BACKEND_URL" \
    "$SIGNERS_FILE_URL" \
    --json > /dev/null

_PENDING_JSON=$("$CLI" list-pending \
    --secret-key "$KEY_0" \
    -u "$BACKEND_URL" \
    --json)
_PENDING_PATH=$(echo "$_PENDING_JSON" | jq -r \
    --arg pat "$PENDING_SIGNERS_DIR" \
    '.pending_files[] | select(.path | contains($pat)) | .path' | head -1)
_PENDING_DIGEST=$(echo "$_PENDING_JSON" | jq -r \
    --arg pat "$PENDING_SIGNERS_DIR" \
    '.pending_files[] | select(.path | contains($pat)) | .digest' | head -1)

# All three signers must sign the initial signers file to activate it
for _KEY in "$KEY_0" "$KEY_1" "$KEY_2"; do
    "$CLI" sign-pending \
        --secret-key "$_KEY" \
        -u "$BACKEND_URL" \
        "$_PENDING_PATH" --digest "$_PENDING_DIGEST" \
        --json > /dev/null
done
unset _KEY _PENDING_JSON _PENDING_PATH _PENDING_DIGEST

printf '%s✓%s\n' "$GREEN" "$RESET"

# --- Register pending releases ---
printf '%sRegistering %d pending releases...%s ' "$DIM" "$PENDING_COUNT" "$RESET"

for _I in $(seq 1 "$PENDING_COUNT"); do
    RELEASE_DIR="$PROJECT_DIR/releases/v0.$_I"
    mkdir -p "$RELEASE_DIR"
    dd if=/dev/urandom of="$RELEASE_DIR/artifact.bin" bs=1024 count=4 2>/dev/null
    (cd "$RELEASE_DIR" && sha256sum artifact.bin > SHA256SUMS)

    "$CLI" register-assets \
        --secret-key "$KEY_0" \
        -u "$BACKEND_URL" \
        --csum-file "$FILE_SERVER_URL/project/releases/v0.$_I/SHA256SUMS" \
        --json > /dev/null
done
unset _I RELEASE_DIR

printf '%s✓%s\n' "$GREEN" "$RESET"

# --- Welcome message ---
printf '\n'
printf '%s━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━%s\n' "$BOLD" "$RESET"
printf '%s  asfaload manual test environment ready%s\n' "$GREEN" "$RESET"
printf '\n'
printf '  %-22s %s\n' "ASFALOAD_BACKEND_URL" "$BACKEND_URL"
printf '  %-22s %s\n' "ASFALOAD_PASSWORD_FILE" "$PASSWORD_FILE"
printf '  %-22s %s\n' "FILE_SERVER_URL" "$FILE_SERVER_URL"
printf '  %-22s %s\n' "KEY_0" "$KEY_0"
printf '  %-22s %s\n' "KEY_1" "$KEY_1"
printf '  %-22s %s\n' "KEY_2" "$KEY_2"
printf '\n'
printf '%s  %d files pending signature%s\n' "$DIM" "$PENDING_COUNT" "$RESET"
printf '  asfaload-cli is in PATH\n'
printf '\n'
printf '%s  Try:%s\n' "$BOLD" "$RESET"
printf '    asfaload-cli list-pending -K $KEY_0\n'
printf '    asfaload-cli sign-pending -K $KEY_0\n'
printf '\n'
printf '%s  Type '"'"'exit'"'"' to stop servers and clean up.%s\n' "$DIM" "$RESET"
printf '%s━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━%s\n\n' "$BOLD" "$RESET"

# --- Spawn the interactive shell ---

mt_spawn_shell
