#!/usr/bin/env bash
set -euo pipefail

# Manual test environment simulating a compromised backend that replaced the
# content of the pending signers file with different (still valid) signers
# content.
#
# list-pending computes the digest from the tampered file on disk, so the
# client's digest pre-check passes: only the validation of the pending signers
# file against the forge source recorded in its metadata rejects the signing.
#
# Start with: ./setup
# Type 'exit' in the spawned shell to stop all servers and clean up.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"

. "$REPO_ROOT/tests/e2e_tests/lib/helpers.sh"
. "$SCRIPT_DIR/../lib.sh"

usage() {
    cat <<EOF
Usage: $(basename "$0") [-h]

Set up a manual test environment with a compromised backend: the backend's
pending signers file content has been replaced with a different signers file.

Type 'exit' in the spawned shell to stop all servers and clean up.

OPTIONS
  -h, --help          Show this help message and exit

ENVIRONMENT SET IN SPAWNED SHELL
  ASFALOAD_BACKEND_URL   Backend REST API address
  ASFALOAD_PASSWORD_FILE Path to file containing the key password
  KEY_0 KEY_1 KEY_2      Paths to fixture private keys
  FILE_SERVER_URL        Local file server address
  PENDING_SIGNERS_FILE   Backend's pending signers file (tampered)
  PENDING_SIGNERS_ORIGINAL Backup of the genuine content (restore source)
  PATH                   target/debug prepended (asfaload-cli available directly)
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        *)
            printf '%sUnknown argument: %s%s\n' "$RED" "$1" "$RESET" >&2
            usage >&2
            exit 1
            ;;
    esac
done

mt_init_workspace
mt_build_binaries
mt_start_file_server
mt_start_backend

# --- Generate the genuine signers file and an alternative one ---

printf '%sGenerating signers files...%s ' "$DIM" "$RESET"

mkdir -p "$PROJECT_DIR/$HIDDEN_SIGNERS_DIR"
GENUINE_NAME="signers_file_1${_SIGNERS_SUFFIX}.json"
ALTERNATIVE_NAME="signers_file_2${_SIGNERS_SUFFIX}.json"
GENUINE="$PROJECT_DIR/$HIDDEN_SIGNERS_DIR/$GENUINE_NAME"
ALTERNATIVE="$PROJECT_DIR/$HIDDEN_SIGNERS_DIR/$ALTERNATIVE_NAME"

# The genuine signers file (the one that gets registered).
"$CLI" new-signers-file \
    --artifact-signers-file "${KEY_0}.pub" \
    --artifact-signers-file "${KEY_1}.pub" \
    --artifact-signers-file "${KEY_2}.pub" \
    -A 2 \
    -o "$GENUINE" \
    > /dev/null 2>&1

# The alternative signers file used as tamper content.
"$CLI" new-signers-file \
    --artifact-signers-file "${KEY_0}.pub" \
    --artifact-signers-file "${KEY_1}.pub" \
    --artifact-signers-file "${KEY_2}.pub" \
    --artifact-signers-file "${KEY_3}.pub" \
    -A 3 \
    -o "$ALTERNATIVE" \
    > /dev/null 2>&1

printf '%s✓%s\n' "$GREEN" "$RESET"

# --- Register the genuine signers file (creates the pending signers file) ---

"$CLI" register-repo \
    --secret-key "$KEY_0" \
    -u "$BACKEND_URL" \
    "$FILE_SERVER_URL/project/$HIDDEN_SIGNERS_DIR/$GENUINE_NAME" \
    --json > /dev/null

# --- Tamper: replace the backend's pending signers file content ---
# The backend's git repo working tree mirrors its project directory
# (scheme/host/port/project, see the backend's path normalisation).

BACKEND_PROJECT_DIR="$BACKEND_REPO/http/localhost/${FILE_SERVER_PORT}/project"
PENDING_SIGNERS_FILE="$BACKEND_PROJECT_DIR/$PENDING_SIGNERS_DIR/$SIGNERS_FILE"
PENDING_SIGNERS_ORIGINAL="$WORK_DIR/pending_signers_original.json"

cp "$PENDING_SIGNERS_FILE" "$PENDING_SIGNERS_ORIGINAL"
cp "$ALTERNATIVE" "$PENDING_SIGNERS_FILE"

if cmp -s "$PENDING_SIGNERS_FILE" "$PENDING_SIGNERS_ORIGINAL"; then
    printf '%sTampering failed: pending signers file unchanged.%s\n' "$RED" "$RESET" >&2
    exit 1
fi

MT_RC_EXTRA_EXPORTS+=(
    "PENDING_SIGNERS_FILE=$PENDING_SIGNERS_FILE"
    "PENDING_SIGNERS_ORIGINAL=$PENDING_SIGNERS_ORIGINAL"
)

# --- Welcome message ---

printf '\n'
printf '%s━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━%s\n' "$BOLD" "$RESET"
printf '%s  Compromised backend: tampered pending signers content%s\n' "$GREEN" "$RESET"
printf '\n'
printf '  %-24s %s\n' "ASFALOAD_BACKEND_URL" "$BACKEND_URL"
printf '  %-24s %s\n' "FILE_SERVER_URL" "$FILE_SERVER_URL"
printf '  %-24s %s\n' "PENDING_SIGNERS_FILE" "$PENDING_SIGNERS_FILE"
printf '  %-24s %s\n' "PENDING_SIGNERS_ORIGINAL" "$PENDING_SIGNERS_ORIGINAL"
printf '\n'
printf '  The pending signers file served by the backend holds different content\n'
printf '  than the forge source its metadata points at (the forge still serves\n'
printf '  the genuine %s).\n' "$GENUINE_NAME"
printf '\n'
printf '%s  Try:%s\n' "$BOLD" "$RESET"
printf '    asfaload-cli list-pending -K $KEY_0\n'
printf '    asfaload-cli sign-pending -K $KEY_0\n'
printf '\n'
printf '%s  Expected:%s signing is rejected with a Hash mismatch error:\n' "$BOLD" "$RESET"
printf '  the client detects that the file differs from the forge source, even\n'
printf '  though the digest reported by list-pending matches the tampered file.\n'
printf '\n'
printf '%s  Restore the genuine content to sign successfully:%s\n' "$BOLD" "$RESET"
printf '    cp $PENDING_SIGNERS_ORIGINAL $PENDING_SIGNERS_FILE\n'
printf '\n'
printf '%s  Type '"'"'exit'"'"' to stop servers and clean up.%s\n' "$DIM" "$RESET"
printf '%s━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━%s\n\n' "$BOLD" "$RESET"

mt_spawn_shell
